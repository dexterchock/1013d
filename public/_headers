# 1. Global Security & HTML (No Cache)
/*
  X-Robots-Tag: index, follow
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate

# 2. Vite Assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 3. Static Images & Icons (Updated for New Files)
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/favicon-96x96.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/web-app-manifest-192x192.png
  Cache-Control: public, max-age=31536000, immutable
/web-app-manifest-512x512.png
  Cache-Control: public, max-age=31536000, immutable
/og-image.jpg
  Cache-Control: public, max-age=31536000, immutable

# 4. Web App Manifest (Recommended: No Long Cache)
# This ensures icon/theme updates trigger for installed PWA users
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# 5. Search Engine Files
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
